<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_saas" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.saas</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='general_settings']" position="inside">
                <block title="SaaS White-Labeling &amp; Branding" name="saas_branding_setting_container">
                    <setting id="saas_brand_setting" help="Configure white-label branding across portal, logins, and browser tabs.">
                        <div class="content-group">
                            <div class="row mt16">
                                <label string="Brand Name" for="saas_app_name" class="col-lg-3 o_light_label"/>
                                <field name="saas_app_name" class="oe_inline"/>
                            </div>
                            <div class="row mt8">
                                <label string="Company Website" for="saas_company_url" class="col-lg-3 o_light_label"/>
                                <field name="saas_company_url" class="oe_inline"/>
                            </div>
                            <div class="row mt8">
                                <label string="Support URL" for="saas_support_url" class="col-lg-3 o_light_label"/>
                                <field name="saas_support_url" class="oe_inline"/>
                            </div>
                            <div class="row mt8">
                                <label string="Docs URL" for="saas_documentation_url" class="col-lg-3 o_light_label"/>
                                <field name="saas_documentation_url" class="oe_inline"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>

